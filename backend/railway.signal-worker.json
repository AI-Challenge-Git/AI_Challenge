{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m scripts.process_signal_jobs --max-jobs 100",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
