APP_ENV=development
DATABASE_URL=postgresql+asyncpg://mts_sos:mts_sos@localhost:5432/mts_sos
DATABASE_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]
ACTIVE_POLICY_VERSION=kb-trading-failure-guidance-2026-08-18
PII_POLICY_VERSION=pii-mask.v1
AI_ADAPTER=fake
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=4
OPENAI_API_KEY=
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_DIR=./data/attachments
SESSION_HMAC_KEY=replace-with-at-least-32-random-bytes
REFERENCE_HMAC_KEY=replace-with-a-different-32-byte-key
AGENT_TOKEN_HMAC_KEY=replace-with-a-third-32-byte-key
RATE_LIMIT_HMAC_KEY=replace-with-a-fourth-32-byte-key
AGENT_ACCESS_TOKEN_TTL_MINUTES=30
AGENT_LOGIN_FAILURE_LIMIT=5
AGENT_LOGIN_FAILURE_WINDOW_SECONDS=300
AGENT_LOGIN_FAILURE_DELAY_MS=300
AGENT_LOOKUP_LIMIT=10
AGENT_LOOKUP_WINDOW_SECONDS=60
AGENT_LOOKUP_FAILURE_DELAY_MS=250
