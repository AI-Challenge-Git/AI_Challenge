AI_ADAPTER=openai
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=4
ANALYSIS_PENDING_STALE_SECONDS=180
REPORT_ANALYZE_LIMIT=5
REPORT_ANALYZE_WINDOW_SECONDS=60
