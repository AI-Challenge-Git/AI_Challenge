{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m scripts.purge_data --execute --batch-size 100",
    "cronSchedule": "17 * * * *",
    "restartPolicyType": "NEVER"
  }
}
